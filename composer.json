{
    "name": "dianaphp/framework",
    "description": "a php framework aiming for simplicity and clean syntax",
    "keywords": [
        "diana",
        "framework",
        "php"
    ],
    "minimum-stability": "dev",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Diana\\": "src/Diana/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "authors": [
        {
            "name": "Antonio Ianzano",
            "email": "ianzanoan@gmail.com"
        }
    ],
    "require": {
        "php": "^8.5.12",
        "filp/whoops": "^2.15",
        "dianaphp/lib": "dev-main",
        "dianaphp/sdk": "dev-main",
        "illuminate/container": "^12.0@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "dianaphp/router": "dev-main"
    },
    "autoload-dev": {
        "psr-4": {
            "Diana\\Tests\\": "tests/"
        }
    }
}
